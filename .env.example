MEDAI_HOME=.medai
MEDAI_DB=.medai/medai.sqlite
MEDAI_BIND=127.0.0.1:8090
# The API token protects the API. Compose requires at least 32 bytes.
MEDAI_API_BEARER_TOKEN=
# Distinct MCP transport bearer. Direct science workers send this over the
# internal Compose network; AgentMesh mode needs equivalent upstream injection.
MEDAI_MCP_BEARER_TOKEN=
# Optional JSON array for tenant-scoped API users. Each token must be 32+ bytes.
# Bind specialist service tokens with scientific_agent_id; use the same random
# token here and in MEDAI_SPECIALIST_API_TOKEN for the matching worker.
# Example: [{"token":"<secret>","subject":"worker-literature","tenant_id":"local","role":"service","scientific_agent_id":"literature_librarian"}]
MEDAI_API_TOKENS=
# Set a retention period to enable daily automatic audit archival. Archive files persist in the Compose data volume.
MEDAI_AUDIT_RETENTION_DAYS=
MEDAI_AUDIT_ARCHIVE_DIR=/data/audit-archive
MEDAI_AUDIT_ARCHIVE_INTERVAL_SECONDS=86400
MEDAI_SPECIALIST_API_TOKEN=
# Generate a unique key for encrypted HttpOnly browser login sessions.
MEDAI_WEB_SESSION_SECRET=
# Optional per-session hard credit ceilings by registered specialist.
# Example: {"scientific_critic":40,"research_director":10}
MEDAI_AGENT_CREDIT_LIMITS=
MEDAI_SERVICE_TENANT_ID=local
MEDAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MEDAI_AGENTMESH_CATALOG=
MEDAI_AGENTMESH_URL=http://host.docker.internal:8080/mcp
# Set this to http://science-mcp:8091/mcp to let workers bypass AgentMesh.
MEDAI_DIRECT_MCP_URL=
# Authenticated AgentMesh admin API for route synchronization and live reuse checks.
AGENTMESH_CONTROL_URL=
AGENTMESH_ADMIN_TOKEN=
AGENTMESH_TENANT=medai
AGENTMESH_NAMESPACE=biomedical
MEDAI_AGENTMESH_SERVICE=medai-mcp
MEDAI_AGENTMESH_SYNC_STATE=.medai/agentmesh/sync-state.json
MEDAI_WASM_SANDBOX_IMAGE=
MEDAI_EMBEDDING_MODEL=/data/embedding-model
MEDAI_CAPABILITY_INDEX=/data/capability-vectors.sqlite
MEDAI_AGENTMESH_CAPABILITY_DIR=integrations/agentmesh/capabilities
MEDAI_CAPABILITY_CALIBRATION_FILE=
MEDAI_CAPABILITY_CALIBRATION_SHA256=
MEDAI_GENCC_CACHE_DIR=.medai/gencc
MEDAI_CLINGEN_CACHE_DIR=.medai/clingen
MEDAI_PROVENANCE_KEY_FILE=.medai/provenance-hmac.key
MEDAI_SKILLS_DIR=.medai/skills
NCBI_EMAIL=
NCBI_API_KEY=
# Optional structured-model provider; remote endpoints require HTTPS.
# For Ollama on the Docker host, set MEDAI_MODEL_BASE_URL to
# http://host.docker.internal:11434/v1 and MEDAI_MODEL_NAME to an installed model tag.
# MEDAI_MODEL_PROVIDER_TYPE accepts openai-compatible, anthropic, or gemini.
MEDAI_MODEL_BASE_URL=
MEDAI_MODEL_NAME=
MEDAI_MODEL_API_KEY=
MEDAI_MODEL_PROVIDER_TYPE=openai-compatible
MEDAI_MODEL_PROVIDER_NAME=openai-compatible
MEDAI_MODEL_TIMEOUT_SECONDS=60
MEDAI_MODEL_MAX_OUTPUT_TOKENS=4096
# Optional JSON mapping from scientific agent IDs to model profiles. Keys are
# referenced by api_key_env and must be provided through the secret manager.
# Example: {"scientific_critic":{"provider_type":"openai-compatible","base_url":"http://host.docker.internal:11435/v1","model":"critic","api_key_env":"MEDAI_MODEL_SCIENTIFIC_CRITIC_API_KEY"}}
# Anthropic profiles set provider_type to "anthropic" and base_url to https://api.anthropic.com/v1.
# Gemini profiles set provider_type to "gemini" and base_url to https://generativelanguage.googleapis.com/v1beta.
MEDAI_AGENT_MODEL_POLICIES=
MEDAI_MODEL_RESEARCH_DIRECTOR_API_KEY=
MEDAI_MODEL_LITERATURE_LIBRARIAN_API_KEY=
MEDAI_MODEL_PAPER_CURATOR_API_KEY=
MEDAI_MODEL_ENTITY_CURATOR_API_KEY=
MEDAI_MODEL_GENE_DISEASE_CURATOR_API_KEY=
MEDAI_MODEL_EVIDENCE_SYNTHESIZER_API_KEY=
MEDAI_MODEL_GENOMICS_ANALYST_API_KEY=
MEDAI_MODEL_PROTEIN_ANALYST_API_KEY=
MEDAI_MODEL_PATHWAY_ANALYST_API_KEY=
MEDAI_MODEL_TRIAL_LIBRARIAN_API_KEY=
MEDAI_MODEL_KNOWLEDGE_GRAPH_CURATOR_API_KEY=
MEDAI_MODEL_HYPOTHESIS_GENERATOR_API_KEY=
MEDAI_MODEL_CAPABILITY_LEARNER_API_KEY=
MEDAI_MODEL_REPRODUCIBILITY_AGENT_API_KEY=
MEDAI_MODEL_SCIENTIFIC_CRITIC_API_KEY=
MEDAI_MODEL_PHARMACOLOGY_ANALYST_API_KEY=
MEDAI_CPU_SECONDS_PER_CREDIT=10
# Optional exact source-license allowlist for sending PMC full-text passages to local inference.
# Empty disables model processing of PMC full text.
MEDAI_PMC_ALLOWED_MODEL_LICENSES=
