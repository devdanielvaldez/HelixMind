# Copy to /etc/medai/backup.env and set owner root:medai, mode 0640.
MEDAI_DB=/var/lib/medai/medai.sqlite
MEDAI_BACKUP_DIR=/var/lib/medai/backups
MEDAI_BACKUP_KEEP_NEWEST=7
MEDAI_BACKUP_MAX_AGE_DAYS=90
MEDAI_BIN=/usr/local/bin/medai
# Optional Alertmanager v2 endpoint; use HTTPS remotely or loopback HTTP locally.
# MEDAI_BACKUP_ALERT_WEBHOOK=http://127.0.0.1:9093/api/v2/alerts
